# 2. DOWNLOAD NOISE & DATASETS

# ==============================================================================

import datasets

import scipy.io.wavfile

import numpy as np

from tqdm import tqdm



output_dir_rirs = "./mit_rirs"

if not os.path.exists(output_dir_rirs):

    os.mkdir(output_dir_rirs)

    print("\nDownloading MIT Room Impulse Responses...")

    rir_dataset = datasets.load_dataset("davidscripka/MIT_environmental_impulse_responses", split="train", streaming=True)

    for row in tqdm(rir_dataset, desc="Downloading RIRs"):

        name = row['audio']['path'].split('/')[-1]

        scipy.io.wavfile.write(os.path.join(output_dir_rirs, name), 16000, (row['audio']['array']*32767).astype(np.int16))



print("\nDownloading full background speech negative dataset (~16GB)...")

!wget -q -nc https://huggingface.co/datasets/davidscripka/openwakeword_features/resolve/main/openwakeword_features_ACAV100M_2000_hrs_16bit.npy

!wget -q -nc https://huggingface.co/datasets/davidscripka/openwakeword_features/resolve/main/validation_set_features.npy



# ==============================================================================

# 3. RAM-SAFE AUDIO DUPLICATION

# ==============================================================================

train_dir = os.path.join(out_dir, model_name, "positive_train")

test_dir = os.path.join(out_dir, model_name, "positive_test")

temp_converted = "/content/temp_16k"



os.makedirs(train_dir, exist_ok=True)

os.makedirs(test_dir, exist_ok=True)

os.makedirs(temp_converted, exist_ok=True)



wav_files = glob.glob(os.path.join(RECORDINGS_FOLDER, "**", "*.wav"), recursive=True)

print(f"\nFound {len(wav_files)} authentic voice recordings.")



converted_files = []

for i, f in enumerate(wav_files):

    dst = os.path.join(temp_converted, f"clean_{i}.wav")

    os.system(f"ffmpeg -y -i '{f}' -ar 16000 -ac 1 -c:a pcm_s16le '{dst}' -loglevel error")

    converted_files.append(dst)



# Reduced sample count to prevent OOM crash at step 75%

TARGET_TRAIN_SAMPLES = 4000

TARGET_TEST_SAMPLES = 400



train_multiplier = max(1, TARGET_TRAIN_SAMPLES // len(converted_files))

test_multiplier = max(1, TARGET_TEST_SAMPLES // len(converted_files))



print("Duplicating recordings across Training and Validation sets...")

for i, f in enumerate(converted_files):

    for dup in range(train_multiplier):

        shutil.copyfile(f, os.path.join(train_dir, f"train_{i}_dup_{dup}.wav"))

    for dup in range(test_multiplier):

        shutil.copyfile(f, os.path.join(test_dir, f"test_{i}_dup_{dup}.wav"))



actual_train_count = len(glob.glob(os.path.join(train_dir, "*.wav")))

actual_test_count = len(glob.glob(os.path.join(test_dir, "*.wav")))

print(f"✅ Prepared {actual_train_count} training seeds & {actual_test_count} validation seeds.")



# ==============================================================================

# 4. CONFIGURATION

# ==============================================================================

config = yaml.load(open("openwakeword/examples/custom_model.yml", 'r').read(), yaml.Loader)



config["target_phrase"] = [TARGET_WAKE_WORD]

config["model_name"] = model_name

config["output_dir"] = out_dir

config["n_samples"] = actual_train_count

config["n_samples_val"] = actual_test_count



config["steps"] = 35000

config["max_negative_weight"] = 2000

config["target_accuracy"] = 0.80

config["target_recall"] = 0.70



config["background_paths"] = ['./mit_rirs']

config["false_positive_validation_data_path"] = "validation_set_features.npy"

config["feature_data_files"] = {"ACAV100M_sample": "openwakeword_features_ACAV100M_2000_hrs_16bit.npy"}



with open('my_model.yaml', 'w') as file:

    yaml.dump(config, file)



